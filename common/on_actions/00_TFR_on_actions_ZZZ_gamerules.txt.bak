							}
						}
						NOT = {
							has_idea = Custom_TFR_war_buff
						}
					}
					apply_war_buff_with_20_divisions = yes
				}
			}
			if = {
				limit = {
					# Algerian Civil War Winner - Algerian Interim Government
					OR = {
						AND = {
							country_exists = ALG
							country_exists = AG1
							ALG = { has_war_with = AG1 }
						}
						AND = {
							country_exists = ALG
							country_exists = AG2
							ALG = { has_war_with = AG2 }
						}
						AND = {
							country_exists = ALG
							country_exists = AG1
							country_exists = AG2
							OR = {
								ALG = { has_war_with = AG1 }
								ALG = { has_war_with = AG2 }
							}
						}
					}
					has_game_rule = {
						rule = TFRNS_Algeria_Civil_War_Winner
