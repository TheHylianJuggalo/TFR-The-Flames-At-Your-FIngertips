
			if = {
				limit = {
					# Maghreb War Winner - Kingdom of Morocco
					has_global_flag = ALG_maghreb_war_global
					has_game_rule = {
						rule = TFRNS_Maghreb_War_Winner
						option = TFRNS_Maghreb_War_Winner_MOR
					}
					NOT = {
						has_global_flag = MAGHREB_WAR_MOR_BUFF_APPLIED
					}
				}
				set_global_flag = MAGHREB_WAR_MOR_BUFF_APPLIED
				every_country = {
					limit = {
						OR = {
							tag = MOR
							tag = WES
							AND = {
								OR = {
									tag = TUN
									tag = MRT
									tag = HRL
									tag = LBA
								}
								is_in_faction_with = MOR
							}
						}
						NOT = {
							has_idea = Custom_TFR_war_buff
						}
					}
					apply_war_buff_with_20_divisions = yes
				}
			}
			if = {
				limit = {
					# Maghreb War Winner - Islamic Republic of Algeria
					has_global_flag = ALG_maghreb_war_global
					has_game_rule = {
						rule = TFRNS_Maghreb_War_Winner
