			if = {
				limit = {
					# Algerian Civil War Winner - Republic of Algeria
					OR = {
						AND = {
							country_exists = AG1
							country_exists = ALG
							AG1 = { has_war_with = ALG }
						}
						AND = {
							country_exists = AG1
